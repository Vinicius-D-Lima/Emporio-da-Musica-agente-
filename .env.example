# Responsabilidade: documentar as variáveis de ambiente e os valores padrão de referência do projeto.

LLM_PROVIDER=gemini
LLM_FALLBACK=groq
GEMINI_API_KEY=[PREENCHER: chave do Gemini]
GROQ_API_KEY=[PREENCHER: chave do Groq]

# Data e hora de referência no fuso America/Campo_Grande
# Se vazio, usa o relógio atual. Horários de feriados não são modelados.
REFERENCE_DATETIME=2026-03-23T10:00:00

GROQ_MODEL=openai/gpt-oss-120b

# Modelo inicial decidido: Gemini Flash
GEMINI_MODEL=gemini-2.5-flash
